{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "qcat-run-report-v2"
    },
    "status": {
      "type": "string",
      "const": "completed"
    },
    "taskVersion": {
      "type": "string",
      "const": "ecc-random-v2"
    },
    "taskManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "circuitSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parametersSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifier": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "buildSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "buildSha256"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "startedAt": {
          "type": "string",
          "maxLength": 40,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "finishedAt": {
          "type": "string",
          "maxLength": 40,
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "exitCode": {
          "type": "number",
          "const": 0
        }
      },
      "required": [
        "startedAt",
        "finishedAt",
        "durationMs",
        "exitCode"
      ],
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "qcat-ecc-random-10048-v1"
        },
        "seed": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputDigestAlgorithm": {
          "type": "string",
          "const": "sha3-256"
        }
      },
      "required": [
        "policy",
        "seed",
        "inputDigest",
        "inputDigestAlgorithm"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "properties": {
        "requestedInputs": {
          "type": "number",
          "const": 10048
        },
        "executedInputs": {
          "type": "number",
          "const": 10048
        },
        "executedBatches": {
          "type": "number",
          "const": 157
        },
        "incorrectInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "classicalMismatchInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10048
        },
        "phaseErrorInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10048
        },
        "workspaceErrorInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10048
        },
        "phaseErrorBatches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 157
        },
        "workspaceErrorBatches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 157
        }
      },
      "required": [
        "requestedInputs",
        "executedInputs",
        "executedBatches",
        "incorrectInputs",
        "classicalMismatchInputs",
        "phaseErrorInputs",
        "workspaceErrorInputs",
        "phaseErrorBatches",
        "workspaceErrorBatches"
      ],
      "additionalProperties": false
    },
    "failureDetails": {
      "type": "object",
      "properties": {
        "encoding": {
          "type": "string",
          "const": "index-error-mask-v1"
        },
        "inputs": {
          "maxItems": 10048,
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10047
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "encoding",
        "inputs"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "qubits": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "totalExecutedToffoli": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "roundedMeanExecutedToffoli": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "tGates": {
          "type": "null"
        },
        "score": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "qubits",
        "totalExecutedToffoli",
        "roundedMeanExecutedToffoli",
        "tGates",
        "score"
      ],
      "additionalProperties": false
    },
    "logSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "taskVersion",
    "taskManifestSha256",
    "circuitSha256",
    "parametersSha256",
    "verifier",
    "run",
    "sampling",
    "checks",
    "failureDetails",
    "resources",
    "logSha256"
  ],
  "additionalProperties": false
}
